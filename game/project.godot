; Godot proje ayarları (Tanhu).
; Bu dosyayı Godot editörü de düzenleyebilir; elle değiştirirken biçimi koruyun.

config_version=5

[application]

config/name="Tanhu"
config/description="Bozkırda ay ışığı altında bir kamp: Tanhu ana menü sahnesi."
config/version="0.1.0"
config/use_custom_user_dir=true
config/custom_user_dir_name="Tanhu Bozkir Destani"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.03, 0.08, 1)
boot_splash/show_image=false

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

AudioManager="*res://scripts/audio/audio_manager.gd"
DevCapture="*res://scripts/dev/capture.gd"
GameSettings="*res://scripts/settings/game_settings.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/Alegreya.ttf"
common/drop_mouse_on_gui_input_disabled=true

[rendering]

anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/positional_shadow/atlas_size=2048
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.08, 1)
scaling_3d/mode=1
scaling_3d/scale=0.67

[shader_globals]

world_time={
"type": "float",
"value": -1.0
}
weather_ground={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
weather_wind={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
