[gd_resource type="Theme" format=3]

[sub_resource type="SystemFont" id="SystemFont_title"]
font_names = PackedStringArray("Cinzel", "Trajan Pro", "Baskerville", "Palatino", "Palatino Linotype", "Book Antiqua", "Georgia", "serif")

[sub_resource type="FontVariation" id="FontVariation_title"]
base_font = SubResource("SystemFont_title")
spacing_glyph = 40

[sub_resource type="SystemFont" id="SystemFont_body"]
font_names = PackedStringArray("Palatino", "Palatino Linotype", "Book Antiqua", "Georgia", "serif")

[sub_resource type="FontVariation" id="FontVariation_button"]
base_font = SubResource("SystemFont_body")
spacing_glyph = 1

[sub_resource type="FontVariation" id="FontVariation_caps"]
base_font = SubResource("SystemFont_body")
spacing_glyph = 2

; İtalik ve kalın biçimler FontVariation ile (eğme / kalınlaştırma) verilir: SystemFont'un
; font_italic / font_weight seçimi macOS'taki .ttc yazı tiplerinde (Palatino) sessizce normale düşer.
[sub_resource type="FontVariation" id="FontVariation_italic"]
base_font = SubResource("SystemFont_body")
variation_transform = Transform2D(1, 0.18, 0, 1, 0, 0)

[sub_resource type="FontVariation" id="FontVariation_bold"]
base_font = SubResource("SystemFont_body")
variation_embolden = 0.6

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_button"]
content_margin_left = 22.0
content_margin_top = 6.0
content_margin_right = 22.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_none"]

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_toast"]
content_margin_left = 40.0
content_margin_top = 12.0
content_margin_right = 40.0
content_margin_bottom = 14.0

[sub_resource type="StyleBoxEmpty" id="StyleBoxEmpty_hud"]
content_margin_left = 34.0
content_margin_top = 14.0
content_margin_right = 38.0
content_margin_bottom = 15.0

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_key"]
content_margin_left = 8.0
content_margin_top = 1.0
content_margin_right = 8.0
content_margin_bottom = 3.0
bg_color = Color(0.949, 0.918, 0.847, 0.92)
border_width_bottom = 2
border_color = Color(0.7, 0.63, 0.52, 0.95)
corner_radius_top_left = 5
corner_radius_top_right = 5
corner_radius_bottom_right = 5
corner_radius_bottom_left = 5

