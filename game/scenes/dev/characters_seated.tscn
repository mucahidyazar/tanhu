[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/world/camp_npcs.tscn" id="1_npcs"]
[ext_resource type="Script" path="res://scripts/camp/rug.gd" id="2_rug"]
[ext_resource type="Script" path="res://scripts/camp/campfire.gd" id="3_fire"]

[sub_resource type="GDScript" id="GDScript_seated"]
script/source = "extends Node3D
## Geliştirme sahnesi: ateş başındaki oturan karakterler (CampNpcs) sade bir zeminde, nötr ışıkta.
## Kesişme ve zemine oturma denetimi için yakın çekim yapılır:
##   tools/capture.sh /tmp/oturan.png 120 --scene=res://scenes/dev/characters_seated.tscn --pose=0.3,2.2,4.2,0,-24
## --hide-model=mete oturan Mete'yi gizler (CampNpcs.set_hidden_model denemesi), --night gece ışığı verir,
## --no-npcs karakterleri kaldırır (kare hızı karşılaştırması için).

@onready var _camera := $Camera as Camera3D


func _ready() -> void:
	var capture := get_node_or_null(^\"/root/DevCapture\")
	if capture:
		capture.pose_requested.connect(func(pos: Vector3, yaw: float, pitch: float) -> void:
			_camera.global_transform = Transform3D(Basis.from_euler(Vector3(deg_to_rad(pitch), deg_to_rad(yaw), 0.0)), pos))
		capture.fov_requested.connect(func(fov_deg: float) -> void: _camera.fov = fov_deg)
	var args := preload(\"res://scripts/dev/capture.gd\").parse_args(OS.get_cmdline_user_args())
	if args.has(\"hide-model\"):
		($CampNpcs as CampNpcs).set_hidden_model(str(args[\"hide-model\"]))
	if args.has(\"no-npcs\"):
		$CampNpcs.queue_free()
	if args.has(\"night\"):
		($Sun as DirectionalLight3D).light_energy = 0.25
		($WorldEnvironment as WorldEnvironment).environment.ambient_light_energy = 0.25
"

[sub_resource type="Environment" id="Environment_seated"]
background_mode = 1
background_color = Color(0.3, 0.38, 0.5, 1)
ambient_light_source = 2
ambient_light_color = Color(0.6, 0.64, 0.75, 1)
