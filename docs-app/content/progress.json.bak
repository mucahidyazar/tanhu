{
  "updated": "2026-11-04T10:45:00.000Z",
  "acts": [
    {
      "id": "foundation",
      "title": "Temel",
      "summary": "Tanhu 3'ten gelen altyapı: menü, oluşturucu, kayıt, ayarlar, Destan Kitabı, gece kampı, kamera, boyalı görünüm, ses, testler ve üretim hatları. Her perde bunun üstüne kurulur."
    },
    {
      "id": "prologue",
      "title": "Önsöz: Kopuz Söyler",
      "page": "/docs/story/prologue",
      "summary": "Ozan kopuzuyla mitolojiyi anlatır, anlatı Mete'nin doğumuna varır; sinema oluşturucuya ve oyunun açılışına bağlanır."
    },
    {
      "id": "childhood",
      "title": "Çocukluk: Koyun Sırtında",
      "page": "/docs/story/childhood",
      "summary": "Mete'nin çocukluğundan kısa, oynanan bir sahne."
    },
    {
      "id": "act-1",
      "title": "I. Perde: Çan",
      "page": "/docs/story/act-1",
      "summary": "Rehine Mete Yüeçi kışlağında: altı gün, Son Gece, kaçış, Kara Boran kovalamacası ve Ev sahnesi. Oyunun çekirdek sistemleri bu perdede kurulur."
    },
    {
      "id": "act-2",
      "title": "II. Perde: Ok Neyi Gösterirse",
      "page": "/docs/story/act-2",
      "summary": "Açık dünya açılır: atlas ve yolculuk, kendi ocağı, yerleşim, para, tek gecelik kamp ve küçük baskınlar."
    },
    {
      "id": "act-3",
      "title": "III. Perde: Boş Toprak",
      "page": "/docs/story/act-3",
      "summary": "Ordu, talim ve toplu savaş bu perdede gelir."
    },
    {
      "id": "act-4",
      "title": "IV. Perde: Borç",
      "page": "/docs/story/act-4",
      "summary": "Perdenin hikâyesi ve getirdiği sistemler."
    },
    {
      "id": "act-5",
      "title": "V. Perde: Dört Renk",
      "page": "/docs/story/act-5",
      "summary": "Perdenin hikâyesi ve getirdiği sistemler."
    },
    {
      "id": "act-6",
      "title": "VI. Perde: Sayım",
      "page": "/docs/story/act-6",
      "summary": "Perdenin hikâyesi ve getirdiği sistemler."
    },
    {
      "id": "epilogue",
      "title": "Sonsöz: Kopuz Susar",
      "page": "/docs/story/epilogue",
      "summary": "Ozanın son sözü; oyunun kapanışı."
    },
    {
      "id": "release",
      "title": "Yayın",
      "summary": "Performans, oyun kolu, İngilizce arayüz, erişilebilirlik ve dışa aktarma. Perdelerle birlikte sürer, sonda kapanır."
    }
  ],
